PORT=5000
NODE_ENV=development
DB_PATH=./rental.db
FRONTEND_URL=http://localhost:5173,https://rental-property-management-software.vercel.app

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Render note:
# - Temporary SQLite is acceptable for demos/tests only because Render's default filesystem is ephemeral.
# - For persistent SQLite on Render, create a Persistent Disk and set DB_PATH=/var/data/rental.db in Render env vars.
