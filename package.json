{
  "name": "rental-property-management-software",
  "version": "1.0.0",
  "description": "Rental Property Management Software - Sprint 1",
  "scripts": {
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test",
    "test:coverage": "npm --prefix backend run test:coverage",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  }
}
